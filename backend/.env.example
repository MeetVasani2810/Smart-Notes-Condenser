# Smart Notes Condenser — Backend Environment Variables
# Copy this file to .env and adjust values as needed.

# Comma-separated list of allowed CORS origins (React dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server host and port (used if running with --host/--port flags)
HOST=127.0.0.1
PORT=8000
